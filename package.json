{
  "name": "mallea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build --config apps/web/vite.config.ts && vite build --config apps/desktop/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:desktop-ui": "vite --config apps/desktop/vite.config.ts",
    "dev:service": "node services/workspace/server.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "desktop": "node scripts/desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fabric": "7.4.0",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
