{
  "productName": "Mallea",
  "identifier": "dev.mallea.runtime",
  "bundle": {
    "active": true,
    "resources": {
      "../../../.mallea/distribution/runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Software that takes your shape",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      },
      "allowDowngrades": false,
      "bundleVCRuntime": true
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "useLocalToolsDir": true
  }
}
